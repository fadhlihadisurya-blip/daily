rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User collection and private subcollections
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create, update: if isValidId(userId) && isOwner(userId)
                            && incoming().keys().hasAll(['uid', 'email'])
                            && incoming().uid == request.auth.uid;
      allow delete: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      // Daily Logs subcollection
      match /daily_logs/{dateStr} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isOwner(userId)
                              && incoming().keys().hasAll(['date', 'prayers'])
                              && incoming().date is string;
        allow delete: if isValidId(userId) && isOwner(userId);
      }

      // Settings subcollection (reminders & preferences)
      match /settings/{settingId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isOwner(userId);
        allow delete: if isValidId(userId) && isOwner(userId);
      }
    }
  }
}
